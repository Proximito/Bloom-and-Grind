# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL. With docker compose the host is "db"; for npm run dev on your laptop use localhost.
POSTGRES_USER=bloom
POSTGRES_PASSWORD=bloom
POSTGRES_DB=bloom
DATABASE_URL=postgresql://bloom:bloom@localhost:5432/bloom?schema=public

# Auth.js / NextAuth. Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Stripe test mode (needed from week 9, A6)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Mailtrap sandbox SMTP (needed for B6)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=xxx
SMTP_PASS=xxx
